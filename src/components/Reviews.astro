---
import { site, brands } from '../data/site';
// Repeat the brand list so the marquee loops seamlessly (translateX -50%).
const loop = [...brands, ...brands, ...brands, ...brands, ...brands, ...brands];
const star = 'M8 1.5l1.9 4.1 4.5.5-3.4 3 1 4.4L8 11.3 4 13.5l1-4.4-3.4-3 4.5-.5z';
---
<section id="reviews" class="section section--centred section--navy">
  <div class="reviews">
    <div class="reviews__live" id="reviews-live" hidden>
      <p class="eyebrow">In our clients' words</p>
      <figure class="review-featured">
        <blockquote id="rv-featured-text"></blockquote>
        <figcaption id="rv-featured-name"></figcaption>
      </figure>
      <div class="rating">
        <span class="rating__score" id="rv-score"></span>
        <span class="rating__stars" role="img" aria-label="Five star rating">
          {[1, 2, 3, 4, 5].map(() => (
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d={star} /></svg>
          ))}
        </span>
        <span class="rating__count" id="rv-count"></span>
      </div>
      <div class="reviews__grid" id="rv-grid"></div>
      {site.googleReviewsUrl && (
        <a class="link-underline" href={site.googleReviewsUrl} rel="noopener" target="_blank">Leave or read reviews on Google</a>
      )}
    </div>
    <div class="brands brands--navy">
      <div class="brands__label"><span class="eyebrow">Built on technology we trust</span><span aria-hidden="true"></span></div>
      <div class="marquee" role="img" aria-label={`Technology we use: ${brands.join(', ')}`}>
        <div class="marquee__track" aria-hidden="true">
          {loop.map((b) => <span class="marquee__item">{b}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  // Reviews come from /api/reviews (Google Places, cached daily). If it's unavailable the block stays hidden.
  (async () => {
    const root = document.getElementById('reviews-live');
    if (!root) return;
    try {
      const res = await fetch('/api/reviews');
      const d = await res.json();
      if (!d.ok || !d.reviews?.length) return;
      // Feature the longest review that still reads well as a headline quote; else the shortest.
      type R = { text: string; name: string };
      const byLen: R[] = [...d.reviews].sort((a: R, b: R) => a.text.length - b.text.length);
      const first: R = [...byLen].reverse().find((r) => r.text.length <= 220) ?? byLen[0];
      const rest: R[] = d.reviews.filter((r: R) => r !== first);
      const set = (id: string, t: string) => { const el = document.getElementById(id); if (el) el.textContent = t; };
      set('rv-featured-text', `“${first.text}”`);
      const fq = document.getElementById('rv-featured-text');
      const n = first.text.length;
      if (fq) fq.dataset.size = n <= 120 ? 'lg' : n <= 240 ? 'md' : 'sm';
      set('rv-featured-name', `${first.name} · Google`);
      if (d.rating) set('rv-score', Number(d.rating).toFixed(1));
      if (d.count) set('rv-count', `${d.count} Google reviews`);
      const grid = document.getElementById('rv-grid');
      rest.slice(0, 2).forEach((r) => {
        const fig = document.createElement('figure');
        fig.className = 'review';
        const q = document.createElement('blockquote');
        q.textContent = `“${r.text}”`;
        const c = document.createElement('figcaption');
        c.textContent = `${r.name} · Google`;
        fig.append(q, c);
        grid?.append(fig);
      });
      root.hidden = false;
    } catch {}
  })();
</script>
