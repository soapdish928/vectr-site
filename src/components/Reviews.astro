---
import { reviews, site } from '../data/site';
const star = 'M8 1.5l1.9 4.1 4.5.5-3.4 3 1 4.4L8 11.3 4 13.5l1-4.4-3.4-3 4.5-.5z';
---
<section id="reviews" class="section section--centred section--navy">
  <div class="reviews">
    <p class="eyebrow">In our clients' words</p>
    <figure class="review-featured">
      <blockquote>“{reviews.featured.quote}”</blockquote>
      <figcaption>{reviews.featured.name} · Google</figcaption>
    </figure>
    <div class="rating">
      <span class="rating__score">{reviews.rating}</span>
      <span class="rating__stars" role="img" aria-label="Five star rating">
        {[1, 2, 3, 4, 5].map(() => (
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d={star} /></svg>
        ))}
      </span>
      <span class="rating__count">{reviews.count} Google reviews</span>
    </div>
    <div class="reviews__grid">
      {reviews.more.map((r) => (
        <figure class="review">
          <blockquote>“{r.quote}”</blockquote>
          <figcaption>{r.name} · Google</figcaption>
        </figure>
      ))}
    </div>
    {site.googleReviewsUrl && (
      <a class="link-underline" href={site.googleReviewsUrl} rel="noopener" target="_blank">Read all reviews on Google</a>
    )}
  </div>
</section>
