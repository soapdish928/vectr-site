---
interface Props {
  to: string;
  label: string;
  up?: boolean;
}
const { to, label, up = false } = Astro.props;
---
<div class="container scroll-row">
  <a class="scroll-link" href={`#${to}`} aria-label={label}>
    {up ? 'BACK TO TOP' : 'SCROLL'}
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
      {up ? <path d="M8 14V2M3 7l5-5 5 5" /> : <path d="M8 2v12M3 9l5 5 5-5" />}
    </svg>
  </a>
</div>
