---
import { site, brands } from '../data/site';

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/brands/*.png', { eager: true });
const logoFor = (name?: string) => (name ? logos[`../assets/brands/${name}.png`]?.default : undefined);
// Repeat the brand list so the marquee loops seamlessly (translateX -50%).
const loop = [...brands, ...brands, ...brands, ...brands, ...brands, ...brands];
---
<section id="aftercare" class="section section--alt">
  <div class="container stack" style="gap: 64px">
    <div class="stack" style="gap: 28px; max-width: 760px">
      <p class="eyebrow">Experience &amp; aftercare</p>
      <h2 class="h2">Looked after, <em>long after install day.</em></h2>
    </div>
    <div class="cards-3">
      <div class="care-card">
        <p class="care-card__label">Experience</p>
        <div class="care-card__big" aria-label="Over 30">30<span aria-hidden="true">+</span></div>
        <h3 class="care-card__title care-card__title--sm">years in technology and networking</h3>
        <p class="care-card__text">A holistic view, drawn from a broad spectrum of industry.</p>
      </div>
      <div class="care-card">
        <p class="care-card__label">Included</p>
        <h3 class="care-card__title">12-month warranty</h3>
        <p class="care-card__text">Equipment and workmanship covered for the first year, as standard.</p>
      </div>
      <div class="care-card care-card--navy">
        <p class="care-card__label">Annual plan</p>
        <h3 class="care-card__title">Support &amp; maintenance</h3>
        <p class="care-card__text">Updates, remote help and maintenance, renewed each year.</p>
        <div class="care-card__foot">{site.supportPlan}</div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="notes">
      <div class="note">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#A14E31" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" /></svg>
        <div>
          <h3 class="note__title">Your data stays yours</h3>
          <p class="note__text">Every CCTV and public Wi-Fi install comes with clear data protection documentation.</p>
        </div>
      </div>
      <div>
        <h3 class="lead-engineer__title">Senior expertise on every project</h3>
        <p class="note__text" style="font-size: 16px">Every system is designed and overseen by a senior project engineer with over 30 years’ experience.</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="brands brands--light">
      <div class="brands__label"><span class="eyebrow">Built on technology we trust</span><span aria-hidden="true"></span></div>
      <div class="marquee" role="img" aria-label={`Technology we use: ${brands.map((b) => b.name).join(', ')}`}>
        <div class="marquee__track" aria-hidden="true">
          {loop.map((b) => {
            const img = logoFor(b.logo);
            return (
              <span class="marquee__item">
                {img ? (
                  <img class="marquee__logo" src={img.src} width={img.width} height={img.height} style={`height:${b.height ?? 36}px`} alt="" loading="lazy" decoding="async" />
                ) : (
                  b.name
                )}
              </span>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
