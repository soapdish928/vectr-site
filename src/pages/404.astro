---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found | Vectr" noindex>
  <Header />
  <main id="main" class="prose">
    <h1>Page not found.</h1>
    <p>That page doesn't exist — it may have moved when we rebuilt the site.</p>
    <p><a href="/">Back to the home page</a> or <a href="/#contact">get in touch</a>.</p>
  </main>
  <Footer />
</Base>
